{
  "name": "@juliuskb/opencode-voice",
  "version": "0.0.6",
  "description": "Local-first voice dictation for OpenCode with push-to-talk Whisper transcription",
  "type": "module",
  "scripts": {
    "check": "tsc -p tsconfig.json",
    "test": "bun test",
    "build": "bun run scripts/build-tui.ts",
    "prepublishOnly": "bun run check && bun test && bun run build"
  },
  "exports": {
    ".": "./src/index.ts",
    "./tui": "./dist/tui.js",
    "./rpc": "./src/rpc.ts"
  },
  "dependencies": {
    "@opencode/plugin": "^2.0.31",
    "sherpa-onnx-node": "1.13.8"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.5.17 <0.7.0",
    "@opentui/solid": ">=0.5.17 <0.7.0",
    "solid-js": ">=1.9.0 <2.0.0"
  },
  "license": "MIT",
  "author": "JuliusKB",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JuliusKB/opencode-voice.git"
  },
  "homepage": "https://github.com/JuliusKB/opencode-voice#readme",
  "bugs": {
    "url": "https://github.com/JuliusKB/opencode-voice/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "voice",
    "dictation",
    "speech-to-text",
    "whisper",
    "sherpa-onnx"
  ],
  "files": [
    "src",
    "dist",
    "index.ts",
    "tui.ts",
    "rpc.ts",
    "tsconfig.json",
    "LICENSE",
    "README.md"
  ],
  "devDependencies": {
    "@opentui/core": "0.6.6",
    "@opentui/solid": "0.6.6",
    "@types/bun": "^1.4.3",
    "solid-js": "1.9.12",
    "typescript": "^5.9.3"
  }
}
